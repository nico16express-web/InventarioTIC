# Al conectar una base de datos Vercel Postgres (Neon) desde el panel de Vercel,
# estas variables se agregan automáticamente al proyecto.
# Para desarrollo local, copia este archivo a ".env" y pega los valores
# que Vercel te muestra en Storage -> tu base de datos -> .env.local

DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"
